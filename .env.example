# Local configuration. scripts/setup.sh (or setup.bat) copies this to .env and generates the secrets.
# .env is read by the app (spring.config.import) and by docker compose. Never commit .env.

# Database (used by the app and by the db container)
DB_NAME=app
DB_USERNAME=app
DB_PASSWORD=app
DB_PORT=5432
DB_URL=jdbc:postgresql://localhost:5432/app

# Redis (cache). Cached entries expire after CACHE_TTL.
REDIS_HOST=localhost
REDIS_PORT=6379
CACHE_TTL=10m

# Mail. Defaults use Mailpit from compose (UI: http://localhost:8025).
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_FROM=no-reply@example.com
# Frontend handling /verify-email?token=... and /reset-password?token=...
MAIL_LINK_BASE_URL=http://localhost:3000
REQUIRE_VERIFIED_EMAIL=false

# JWT signing secret, at least 32 characters
JWT_SECRET=
JWT_ACCESS_TOKEN_TTL=15m
JWT_REMEMBER_ME_TTL=30d

# Set to true when served over HTTPS
COOKIE_SECURE=false
# Comma-separated browser origins allowed to call the API
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Initial admin, created on startup if no admin exists
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

PORT=8080
